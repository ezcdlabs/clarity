<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission the app needs: it talks to a git host and nothing
         else. No analytics, no accounts, no provider SDK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- To say a pipeline went red while the app was closed. Asked for at the
         moment it first means something, not at launch. Deliberately NOT
         USE_FULL_SCREEN_INTENT: a background check is up to a quarter of an
         hour behind, and waking a phone at 3am over something that broke
         twenty minutes ago is the behaviour of an alarm clock rather than of a
         dashboard. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- For the short cue the open repository gets instead of a notification.
         Granted at install; the phone's own silent and Do Not Disturb rules
         still apply, because the tone goes out on the notification stream. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The self-updater: the app is distributed through its own GitHub
         releases, not a store, so updating IS handling a package. The system
         still runs its own confirmation dialog, the user approves installs
         from this app exactly once, and Android refuses any APK whose signing
         key differs from the installed app's — this permission opens the
         door to the system installer, nothing more. (It also forecloses a
         Play Store listing, which forbids self-updating apps; that is a
         recorded trade, not an oversight.) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="clarity"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clarity">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Clarity.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Where the update install session reports back. Not exported: only
             the system installer, replying to our own session's IntentSender,
             ever sends here. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
