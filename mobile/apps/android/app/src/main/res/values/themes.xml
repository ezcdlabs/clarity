<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The light theme, with res/values-night overriding it. This only has to
         paint the window before Compose draws its first frame and the ground
         behind the system bars — everything else is decided in Compose. It
         still matters: a hardcoded dark window under a light system tray is
         what made the status bar unreadable. -->
    <style name="Theme.Clarity" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FCFCFC</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The theme the launcher starts us in. It exists only to paint the brand
         while the process starts; MainActivity swaps to Theme.Clarity before it
         draws anything, so this never reaches the app itself.

         Brand navy in both light and dark, deliberately: a splash is the mark,
         and the mark has one colour. -->
    <style name="Theme.Clarity.Splash" parent="Theme.Clarity">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
